<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="MySql.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup Condition="'$(PublishTrimmed)' == 'true'">
    <DebugType>none</DebugType>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <InvariantGlobalization>true</InvariantGlobalization>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <MvcEnhancedModelMetadataSupport>true</MvcEnhancedModelMetadataSupport>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <ItemGroup Condition="'$(PublishTrimmed)' == 'true'">
    <TrimmerRootAssembly Include="Microsoft.AspNetCore.Antiforgery" />
    <TrimmerRootAssembly Include="Microsoft.AspNetCore.Html.Abstractions" />
    <TrimmerRootAssembly Include="Microsoft.AspNetCore.Mvc" />
    <TrimmerRootAssembly Include="Microsoft.AspNetCore.Mvc.Abstractions" />
    <TrimmerRootAssembly Include="Microsoft.AspNetCore.Mvc.Core" />
    <TrimmerRootAssembly Include="Microsoft.AspNetCore.Mvc.DataAnnotations" />
    <TrimmerRootAssembly Include="Microsoft.AspNetCore.Mvc.Razor" />
    <TrimmerRootAssembly Include="Microsoft.AspNetCore.Mvc.TagHelpers" />
    <TrimmerRootAssembly Include="Microsoft.AspNetCore.Mvc.ViewFeatures" />
    <TrimmerRootAssembly Include="Microsoft.AspNetCore.Razor" />
    <TrimmerRootAssembly Include="Microsoft.AspNetCore.Razor.Runtime" />
    <TrimmerRootAssembly Include="System.ComponentModel.Annotations" />
    <TrimmableAssembly Include="BouncyCastle.Cryptography" />
  </ItemGroup>

</Project>
