@using System.Globalization
@model PaymentFormViewModel
@{
    ViewData["Title"] = "Record payment";
    ViewData["Subtitle"] = "Fees are calculated from the member's stored plan.";
    var selected = Model.Selected.ToString(CultureInfo.InvariantCulture);
}
<form class="form" method="get" action="/admin/payments/new">
    <section class="form-section">
        <div class="form-section__intro">
            <h2>Member</h2>
            <p>Only primary members can pay. Sub-members use the primary account.</p>
        </div>
        <div class="fields">
            <div class="field field--full">
                <label for="f_member">Member</label>
                <select id="f_member" name="user_id" data-autosubmit>
                    <option value="">Select a member</option>
                    @foreach (var (id, label) in Model.Members)
                    {
                        <option value="@id" selected="@(id == selected)">@label</option>
                    }
                </select>
            </div>
            <noscript><button class="button" type="submit">Load member</button></noscript>
        </div>
    </section>
</form>

@if (Model.Selected > 0)
{
    <form class="form" method="post" action="/admin/payments" asp-antiforgery="true">
        <input type="hidden" name="user_id" value="@Model.Selected">
        <section class="form-section">
            <div class="form-section__intro">
                <h2>Payment type</h2>
                <p>The joining fee comes first. After that the other types unlock.</p>
            </div>
            <fieldset class="choices">
                <legend class="sr-only">Payment type</legend>
                @foreach (var option in Model.TypeOptions)
                {
                    <label class="choice">
                        <input type="radio" name="type" value="@option.Value" checked="@(Model.CheckedType == option.Value)">
                        <span class="choice__body">
                            <strong>@option.Label</strong>
                            <span class="muted num">@option.AmountText</span>
                        </span>
                    </label>
                }
            </fieldset>
        </section>
        <section class="form-section">
            <div class="form-section__intro">
                <h2>Details</h2>
                <p>Amounts for joining, yearly and quarterly are set by the plan.</p>
            </div>
            <div class="fields">
                <div class="contents" data-when="type:bonus,points" hidden>
                    <field asp-for="Amount" label="Amount" type="number" min="0.01" step="0.01" />
                </div>
                <div class="contents" data-when="type:quarterly" hidden>
                    <field asp-for="Quarters" label="Quarters to pay" type="select" items="Model.QuarterChoices" />
                </div>
                <div class="contents" data-when="type:yearly" hidden>
                    <field asp-for="TermStart" label="Term start" type="select" items="Model.TermChoices" />
                </div>
                <field asp-for="PaidOn" label="Paid on" type="date" required />
                <field asp-for="Remark" label="Mode of payment" hint="For example bank transfer or card." class="field--full" required />
            </div>
        </section>
        <div class="form-actions">
            <button class="button" type="submit">Record payment</button>
            <a class="button button--quiet" href="/admin/payments">Cancel</a>
        </div>
    </form>
}
