@model FlightList
@{
    ViewData["Title"] = "Reservations";
    ViewData["Subtitle"] = $"{Model.Count} on record";
}
@section actions {
<a class="button" href="/admin/reservations/new"><icon name="plus" class="icon icon--sm" />New reservation</a>
}
@if (Model.Count == 0)
{
    <partial name="partials/empty" model='new EmptyState("No reservations yet", "Book a flight for a member and choose their seats.", "ticket", "/admin/reservations/new", "New reservation")' />
}
else
{
    <partial name="partials/flight_list" model="Model" />
}
