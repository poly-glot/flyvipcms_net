@model PasswordViewModel
@{
    ViewData["Title"] = "Password";
    ViewData["Subtitle"] = "Change the password you use to sign in.";
}
<form class="form" method="post" action="/account/password" asp-antiforgery="true">
    <section class="form-section">
        <div class="form-section__intro">
            <h2>Sign-in password</h2>
            <p>Use at least 8 characters. It must differ from your current password.</p>
        </div>
        <div class="fields fields--narrow">
            <field asp-for="CurrentPassword" label="Current password" type="password" class="field--full" autocomplete="current-password" required />
            <field asp-for="NewPassword" label="New password" type="password" class="field--full" autocomplete="new-password" minlength="8" required />
            <field asp-for="ConfirmPassword" label="Confirm new password" type="password" class="field--full" autocomplete="new-password" required />
        </div>
    </section>
    <div class="form-actions"><button class="button" type="submit">Update password</button></div>
</form>
