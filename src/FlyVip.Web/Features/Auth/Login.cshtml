@model LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sign in";
}
<div class="gate__heading">
    <h1>Sign in</h1>
    <p class="muted">Welcome back. Manage your flights and points.</p>
</div>
<partial name="partials/error_summary" />
<form class="form" method="post" action="/login" asp-antiforgery="true">
    <div class="fields">
        <field asp-for="Email" label="Email" type="email" class="field--full" autocomplete="email" autofocus required />
        <field asp-for="Password" label="Password" type="password" class="field--full" autocomplete="current-password" required />
    </div>
    <div class="form-actions form-actions--bare">
        <button class="button button--block" type="submit">Sign in</button>
    </div>
</form>
<p class="muted gate__note">Memberships are arranged with our concierge team.</p>
