@{
    var errors = ValidationErrors.Of(ViewData);
}
@if (errors.Count > 0)
{
    <div class="summary" role="alert">
        <icon name="alert" />
        <div>
            <strong>@(errors.Count == 1 ? "One thing needs your attention" : $"{errors.Count} things need your attention")</strong>
            <ul>
                @foreach (var error in errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    </div>
}
